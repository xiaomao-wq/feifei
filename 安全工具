    def format_alert_time(self, time_str):
        """格式化告警时间 将日期分隔符改为/ 保留完整时间"""
        try:
            # 尝试解析各种常见的时间格式
            for fmt in ("%Y-%m-%d %H:%M:%S", "%Y/%m/%d %H:%M:%S", "%Y%m%d%H%M%S", "%Y-%m-%d %H:%M", "%Y/%m/%d %H:%M"):
                try:
                    dt = datetime.datetime.strptime(time_str, fmt)
                    return dt.strftime("%Y/%m/%d %H:%M:%S")
                except ValueError:
                    continue

            # 尝试直接替换日期分隔符
            if len(time_str) >= 10:
                # 替换日期部分的分隔符
                date_part = time_str[:10].replace("-", "/")
                # 保留时间部分
                time_part = time_str[10:] if len(time_str) > 10 else ""
                return date_part + time_part

            return time_str
        except Exception:
            return time_str

    def validate_ip(self, event=None):
        """验证IP地址格式"""
        widget = event.widget if event else None
        ip = widget.get() if widget else ""

        try:
            ipaddress.ip_address(ip)
            widget.config(foreground='black')
            return True
        except ValueError:
            widget.config(foreground='red')
            return False

    def validate_province(self, event=None):
        """验证省份字段 - 如果国家是中国，省份不能为空"""
        widget = event.widget if event else None
        if not widget:
            return True

        if widget == self.entry_attack_country:
            country = self.entry_attack_country.get()
            province = self.entry_attack_province.get()
            province_widget = self.entry_attack_province
        else:
            country = self.entry_target_country.get()
            province = self.entry_target_province.get()
            province_widget = self.entry_target_province

        # 如果国家是中国，省份不能为空
        if country == "中国" and not province.strip():
            province_widget.config(foreground='red')
            return False
        else:
            province_widget.config(foreground='black')
            return True

    def validate_port(self, event=None):
        """验证端口格式并自动去除空格、回车、tab"""
        widget = event.widget if event else None
        if not widget:
            return False

        # 获取输入内容并去除空格、回车、tab
        original_text = widget.get()
        cleaned_text = original_text.strip().replace('\r', '').replace('\n', '').replace('\t', '')

        # 如果内容有变化，更新输入框
        if cleaned_text != original_text:
            widget.delete(0, tk.END)
            widget.insert(0, cleaned_text)

        # 验证是否为数字
        if cleaned_text.isdigit():
            widget.config(foreground='black')
            return True
        else:
            widget.config(foreground='red')
            return False

    def validate_form(self):
        """验证表单数据"""
        errors = []

        # 验证安全事件上报日期序号
        if self.create_main_folder_var.get() and not self.entry_report_id.get():
            errors.append("安全事件上报日期序号不能为空")

        # 验证序号
        if not self.entry_id.get().isdigit():
            errors.append("序号必须是数字")

        # 处理攻击IP
        attack_ip = self.entry_attack_ip.get().strip().replace('\r', '').replace('\n', '').replace('\t', '')
        if attack_ip != self.entry_attack_ip.get():
            self.entry_attack_ip.delete(0, tk.END)
            self.entry_attack_ip.insert(0, attack_ip)

        if not attack_ip:
            errors.append("攻击IP不能为空")
        elif not self.validate_ip_target(self.entry_attack_ip):
            errors.append("攻击IP格式无效")

        # 处理目的IP
        target_ip = self.entry_target_ip.get().strip().replace('\r', '').replace('\n', '').replace('\t', '')
        if target_ip != self.entry_target_ip.get():
            self.entry_target_ip.delete(0, tk.END)
            self.entry_target_ip.insert(0, target_ip)

        if not target_ip:
            errors.append("目的IP不能为空")
        elif not self.validate_ip_target(self.entry_target_ip):
            errors.append("目的IP格式无效")

        # 处理并验证攻击端口
        attack_port = self.entry_attack_port.get().strip().replace('\r', '').replace('\n', '').replace('\t', '')
        if attack_port != self.entry_attack_port.get():
            self.entry_attack_port.delete(0, tk.END)
            self.entry_attack_port.insert(0, attack_port)

        if not attack_port:
            errors.append("攻击端口不能为空")
        elif not attack_port.isdigit():
            errors.append("攻击端口必须是数字")

        # 处理并验证目的端口
        target_port = self.entry_target_port.get().strip().replace('\r', '').replace('\n', '').replace('\t', '')
        if target_port != self.entry_target_port.get():
            self.entry_target_port.delete(0, tk.END)
            self.entry_target_port.insert(0, target_port)

        if not target_port:
            errors.append("目的端口不能为空")
        elif not target_port.isdigit():
            errors.append("目的端口必须是数字")

        # 验证归属地
        if not self.validate_province_target(self.entry_attack_country, self.entry_attack_province):
            errors.append("攻击IP归属地: 如果国家是中国，省份不能为空")
        if not self.validate_province_target(self.entry_target_country, self.entry_target_province):
            errors.append("目的IP归属地: 如果国家是中国，省份不能为空")

        # 验证攻击类型
        if not self.entry_attack_type.get():
            errors.append("攻击类型不能为空")

        # 验证告警时间
        if not self.alert_time.get():
            errors.append("告警时间不能为空")

        return errors

    def validate_ip_target(self, widget):
        """验证指定IP控件"""
        ip = widget.get()
        try:
            ipaddress.ip_address(ip)
            widget.config(foreground='black')
            return True
        except ValueError:
            widget.config(foreground='red')
            return False

    def validate_province_target(self, country_widget, province_widget):
        """验证指定归属地控件"""
        country = country_widget.get()
        province = province_widget.get()

        # 如果国家是中国，省份不能为空
        if country == "中国" and not province.strip():
            province_widget.config(foreground='red')
            return False
        else:
            province_widget.config(foreground='black')
            return True

    def create_folder_structure(self, report_id, seq_id):
        """创建文件夹结构并返回新文件夹路径"""
        try:
            # 获取输出文件夹
            output_base = self.output_folder.get()

            # 创建主文件夹结构
            if self.create_main_folder_var.get():
                # 主文件夹名称
                main_folder_name = f"家庭产品部-安全事件上报{report_id}"
                # 完整的主文件夹路径
                base_folder = os.path.join(output_base, main_folder_name)
            else:
                # 如果不创建主文件夹，直接使用输出文件夹
                base_folder = output_base

            # 创建基础文件夹
            if not os.path.exists(base_folder):
                os.makedirs(base_folder)

            # 创建三个子文件夹
            subfolders = [f"{seq_id}", f"{seq_id}_log", f"{seq_id}_picture"]
            for folder in subfolders:
                folder_path = os.path.join(base_folder, folder)
                if not os.path.exists(folder_path):
                    os.makedirs(folder_path)

            return base_folder, os.path.join(base_folder, seq_id)  # 返回主文件夹路径和序号文件夹路径
        except Exception as e:
            messagebox.showerror("文件夹创建错误", f"无法创建文件夹: {str(e)}")
            return None, None

    def collect_all_events(self, base_folder):
        """收集所有序号文件夹中的事件数据"""
        all_events = []  # 存储所有事件数据

        # 查找所有序号文件夹（纯数字命名的文件夹）
        for folder_name in os.listdir(base_folder):
            folder_path = os.path.join(base_folder, folder_name)
            if os.path.isdir(folder_path) and folder_name.isdigit():
                # 查找该文件夹中的Excel文件
                excel_files = glob.glob(os.path.join(folder_path, "安全事件汇总.xlsx"))
                if excel_files:
                    excel_file = excel_files[0]
                    try:
                        wb = load_workbook(excel_file)
                        sheet = wb.active
                        # 获取第二行数据（跳过标题行）
                        row_data = []
                        for cell in sheet[2]:  # 第二行
                            row_data.append(cell.value)
                        all_events.append(row_data)
                        wb.close()
                    except Exception as e:
                        print(f"读取文件 {excel_file} 出错: {str(e)}")

        return all_events

    def generate_master_summary(self, base_folder):
        """生成主文件夹中的汇总文件"""
        # 获取模板文件路径
        template_file = self.template_path.get()
        if not os.path.exists(template_file):
            raise FileNotFoundError(f"模板文件不存在: {template_file}")

        # 收集所有事件数据
        all_events = self.collect_all_events(base_folder)
        if not all_events:
            return False

        try:
            # 加载模板文件
            wb = load_workbook(template_file)
            sheet = wb.active

            # 清空旧数据（保留标题行）
            if sheet.max_row > 1:
                sheet.delete_rows(2, sheet.max_row - 1)

            # 添加所有事件数据（从第二行开始）
            for event_data in all_events:
                sheet.append(event_data)

            # 保存到主文件夹
            output_file = os.path.join(base_folder, "安全事件汇总.xlsx")
            wb.save(output_file)
            wb.close()
            return True
        except Exception as e:
            raise RuntimeError(f"生成汇总文件失败: {str(e)}")

