CONFIG_FILE = "saved_paths.json"


def load_saved_paths():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, dict):
                    converted = {}
                    for k, v in data.items():
                        if isinstance(v, str):
                            converted[k] = {"dir": v, "file": None}
                        else:
                            converted[k] = v
                    return converted
                return data
        except:
            return {}
    return {}


def save_paths(paths_dict):
    with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
        json.dump(paths_dict, f, ensure_ascii=False, indent=2)


class LocalToolboxGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("路径管理 & 快速打开CMD / 运行文件")
        self.root.geometry("880x580")
        self.root.resizable(True, True)

        self.paths = load_saved_paths()

        self.create_widgets()

    def create_widgets(self):
        main_frame = ttk.Frame(self.root, padding="15 10")
        main_frame.pack(fill=tk.BOTH, expand=True)

        ttk.Label(main_frame, text="已保存的路径 / 文件（双击打开CMD或运行文件）",
                  font=("Microsoft YaHei", 12, "bold")).pack(pady=(0, 10))

        self.listbox = tk.Listbox(main_frame, font=("Consolas", 11), height=14, selectmode=tk.SINGLE,
                                  activestyle="dotbox")
        self.listbox.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        self.listbox.bind("<Double-Button-1>", self.open_selected)
        self.listbox.bind("<Delete>", self.delete_selected)
        self.listbox.bind("<Return>", self.open_selected)

        btn_frame = ttk.Frame(main_frame)
        btn_frame.pack(fill=tk.X, pady=12)

        self.start_btn = ttk.Button(btn_frame, text="添加路径/文件", command=self.add_path_or_file, width=16)
        self.start_btn.pack(side=tk.LEFT, padx=8)

        ttk.Button(btn_frame, text="删除选中", command=self.delete_selected, width=14).pack(side=tk.LEFT, padx=8)
        ttk.Button(btn_frame, text="刷新列表", command=self.refresh_list, width=14).pack(side=tk.LEFT, padx=8)
        ttk.Button(btn_frame, text="退出", command=self.root.quit, width=14).pack(side=tk.RIGHT, padx=8)

        self.refresh_list()

    def refresh_list(self):
        self.listbox.delete(0, tk.END)
        for name in sorted(self.paths.keys()):
            data = self.paths[name]
            dir_part = data.get("dir", "")
            file_part = data.get("file")
            display = f"{name}  →  {dir_part}"
            if file_part:
                display += f"  ({file_part})"
            self.listbox.insert(tk.END, display)

    def add_path_or_file(self):
        path = filedialog.askopenfilename(
            title="选择文件 或 仅选文件夹",
            filetypes=[("所有文件", "*.*"), ("Python文件", "*.py"), ("文本文件", "*.txt"),
                       ("可执行文件", "*.exe *.bat")]
        )

        if path:
            target_dir = os.path.dirname(path)
            target_file = os.path.basename(path)
        else:
            folder = filedialog.askdirectory(title="请选择文件夹")
            if not folder:
                return
            target_dir = folder
            target_file = None

        preview_win = Toplevel(self.root)
        preview_win.title(f"预览 - {target_dir}")
        preview_win.geometry("780x580")
        preview_win.minsize(700, 500)
        preview_win.transient(self.root)
        preview_win.grab_set()

        ttk.Label(preview_win, text=f"目录：{target_dir}\n文件：{target_file or '（无具体文件，仅路径）'}",
                  font=("Microsoft YaHei", 11)).pack(pady=8, padx=12, anchor="w")

        tree_frame = ttk.Frame(preview_win)
        tree_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)

        tree = ttk.Treeview(tree_frame, columns=("type", "name"), show="headings")
        tree.heading("type", text="类型")
        tree.heading("name", text="名称")
        tree.column("type", width=80, anchor="center")
        tree.column("name", width=600)

        vsb = ttk.Scrollbar(tree_frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        vsb.pack(side=tk.RIGHT, fill=tk.Y)

        self.load_directory_tree(tree, "", target_dir)

        tree.bind("<<TreeviewOpen>>", lambda e: self.on_tree_expand(tree, target_dir))
        tree.bind("<Double-1>", lambda e: self.open_file_or_folder(tree, target_dir))

        btn_frame = ttk.Frame(preview_win)
        btn_frame.pack(fill=tk.X, pady=12)

        def confirm_save():
            name = tk.simpledialog.askstring("命名", "给这个路径/文件起个名字：", parent=preview_win)
            if not name or not name.strip():
                messagebox.showwarning("提示", "名称不能为空")
                return

            name = name.strip()
            if name in self.paths:
                if not messagebox.askyesno("覆盖", f"'{name}' 已存在，是否覆盖？"):
                    return

            self.paths[name] = {"dir": target_dir, "file": target_file}
            save_paths(self.paths)
            self.refresh_list()
            messagebox.showinfo("成功",
                                f"已保存：\n{name} → {target_dir}" + (f" ({target_file})" if target_file else ""))
            preview_win.destroy()

        ttk.Button(btn_frame, text="确认保存", command=confirm_save, width=18).pack(side=tk.LEFT, padx=20)
        ttk.Button(btn_frame, text="取消", command=preview_win.destroy, width=12).pack(side=tk.RIGHT, padx=20)

    def load_directory_tree(self, tree, parent_iid, path):
        try:
            items = sorted(os.listdir(path))
            for item in items:
                full_path = os.path.join(path, item)
                item_type = "文件夹" if os.path.isdir(full_path) else "文件"
                iid = tree.insert(parent_iid, "end", text=item, values=(item_type, item))

                if os.path.isdir(full_path):
                    tree.insert(iid, "end", text="加载中...")
        except Exception as e:
            tree.insert(parent_iid, "end", values=("", f"读取失败: {str(e)}"))

    def on_tree_expand(self, tree, base_path):
        selected = tree.focus()
        if not selected:
            return

        children = tree.get_children(selected)
        if len(children) > 0 and tree.item(children[0])["text"] != "加载中...":
            return

        for child in children:
            tree.delete(child)

        item_name = tree.item(selected)["text"]
        current_path = os.path.join(base_path, item_name)

        if os.path.isdir(current_path):
            self.load_directory_tree(tree, selected, current_path)

    def open_file_or_folder(self, tree, base_path):
        selected = tree.focus()
        if not selected:
            return

        item_name = tree.item(selected)["text"]
        full_path = os.path.join(base_path, item_name)

        if os.path.isdir(full_path):
            if not tree.item(selected, "open"):
                tree.item(selected, open=True)
            return

        try:
            if sys.platform == "win32":
                os.startfile(full_path)
            else:
                subprocess.Popen(['xdg-open', full_path])
        except Exception as e:
            messagebox.showerror("打开失败", f"无法打开：\n{full_path}\n{str(e)}")

    def delete_selected(self, event=None):
        selection = self.listbox.curselection()
        if not selection:
            messagebox.showwarning("提示", "请先选中要删除的项")
            return

        item = self.listbox.get(selection[0])
        name = item.split(" → ")[0].strip()

        if messagebox.askyesno("确认删除", f"确定删除 '{name}' 吗？"):
            self.paths.pop(name, None)
            save_paths(self.paths)
            self.refresh_list()

    def open_selected(self, event=None):
        selection = self.listbox.curselection()
        if not selection:
            return

        item = self.listbox.get(selection[0])
        name = item.split(" → ")[0].strip()
        data = self.paths.get(name, {})
        dir_path = data.get("dir")
        file_name = data.get("file")

        if not dir_path or not os.path.isdir(dir_path):
            messagebox.showerror("错误", f"路径不存在：\n{dir_path}")
            return

        try:
            if sys.platform == "win32":
                cmd = f'start cmd /k cd /d "{dir_path}"'
                if file_name:
                    full_file = os.path.join(dir_path, file_name)
                    if file_name.lower().endswith(".py"):
                        cmd += f' && python "{full_file}"'
                    elif file_name.lower().endswith((".exe", ".bat", ".cmd")):
                        cmd += f' && "{full_file}"'
                subprocess.Popen(cmd, shell=True)
            else:
                subprocess.Popen(['gnome-terminal', '--working-directory', dir_path, '--', 'bash'])
        except Exception as e:
            messagebox.showerror("打开失败", str(e))


