        self.ports_var = tk.StringVar(value="80,443")
        ttk.Entry(frame, textvariable=self.ports_var, width=35).grid(row=1, column=1, sticky="w", pady=6)
        ttk.Label(frame, text="(用逗号分隔)").grid(row=1, column=2, sticky="w", padx=5)

        ttk.Label(frame, text="DNS服务器:").grid(row=2, column=0, sticky="e", pady=6, padx=5)
        self.dns_var = tk.StringVar(value="223.5.5.5")
        dns_options = ["223.5.5.5", "223.6.6.6", "119.29.29.29", "8.8.8.8", "1.1.1.1", "114.114.114.114"]
        self.dns_combo = ttk.Combobox(frame, textvariable=self.dns_var, values=dns_options, width=32, state="normal")
        self.dns_combo.grid(row=2, column=1, sticky="w", pady=6)

        self.btn_start = ttk.Button(frame, text="开始枚举", command=self.toggle_scan, width=15)
        self.btn_start.grid(row=3, column=0, columnspan=2, pady=12)

        self.result_text = scrolledtext.ScrolledText(frame, width=85, height=24, font=("Consolas", 10))
        self.result_text.grid(row=4, column=0, columnspan=3, pady=5, sticky="nsew")

        self.status_var = tk.StringVar(value="就绪")
        ttk.Label(frame, textvariable=self.status_var).grid(row=5, column=0, columnspan=3, sticky="w", pady=3)

        frame.columnconfigure(1, weight=1)
        frame.rowconfigure(4, weight=1)

    def log(self, msg):
        self.queue.put(msg + "\n")

    def update_ui(self):
        while not self.queue.empty():
            line = self.queue.get()
            self.result_text.insert(tk.END, line)
            self.result_text.see(tk.END)
        self.root.after(150, self.update_ui)

    def toggle_scan(self):
        if self.running:
            self.running = False
            self.btn_start.config(text="开始枚举")
            self.status_var.set("已停止")
        else:
            domain = self.domain_var.get().strip()
            if not domain:
                messagebox.showwarning("提示", "请输入目标域名")
                return

            ports_str = self.ports_var.get().strip()
            if not ports_str:
                ports = [80, 443]
            else:
                try:
                    ports = [int(p.strip()) for p in ports_str.split(",") if p.strip().isdigit()]
                    if not ports:
                        ports = [80, 443]
                except:
                    messagebox.showwarning("提示", "端口格式错误，已使用默认80,443")
                    ports = [80, 443]

            dns_server = self.dns_var.get().strip()
            if not dns_server:
                dns_server = "223.5.5.5"

            self.result_text.delete("1.0", tk.END)
            self.running = True
            self.btn_start.config(text="停止扫描")
            self.status_var.set("扫描中...")

            threading.Thread(target=self.scan_thread, args=(domain, ports, dns_server), daemon=True).start()
            self.root.after(200, self.update_ui)

    def scan_thread(self, domain, ports, dns_server):
        resolver = dns.resolver.Resolver()
        resolver.nameservers = [dns_server]

        total = len(common_subdomains)
        found_count = 0

        self.log(f"目标域名: {domain}")
        self.log(f"使用DNS服务器: {dns_server}")
        self.log(f"扫描端口: {','.join(map(str, ports))}")
        self.log(f"字典数量: {total} 个\n")

        for i, sub in enumerate(common_subdomains, 1):
            if not self.running:
                self.log("\n扫描已手动停止")
                break

            full_domain = f"{sub}.{domain}"
            self.status_var.set(f"({i}/{total}) 正在解析 {full_domain}")

            try:
                answers = resolver.resolve(full_domain, "A")
                ip = answers[0].address

                open_ports = []
                for port in ports:
                    try:
                        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                        sock.settimeout(1.2)
                        result = sock.connect_ex((ip, port))
                        sock.close()
                        if result == 0:
                            open_ports.append(port)
                    except:
                        pass

                port_str = ",".join(map(str, open_ports)) if open_ports else "无开放端口"
                line = f"{full_domain:28} → {ip:15} 开放端口: {port_str}"
                self.log(line)

                if open_ports:
                    found_count += 1

            except (dns.resolver.NXDOMAIN, dns.resolver.NoAnswer, dns.resolver.Timeout):
                pass
            except Exception as e:
                self.log(f"{full_domain} 异常: {str(e)}")

            time.sleep(0.02)

        if self.running:
            self.log(f"\n扫描完成！发现 {found_count} 个解析成功的子域名")
            self.running = False
            self.btn_start.config(text="开始枚举")
            self.status_var.set("扫描完成")


