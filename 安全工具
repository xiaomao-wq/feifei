                                                                                        pady=20)

    def save_config(self):
        self.apis = {}
        for engine, entries in self.config_entries.items():
            config = {k.lower().replace(" ", "_"): v.get().strip() for k, v in entries.items()}
            if all(config.values()):
                self.apis[engine] = config
        messagebox.showinfo("配置", f"已保存 {len(self.apis)} 个引擎的配置")

    def create_query_tab(self):
        tab = ttk.Frame(self.notebook)
        self.notebook.add(tab, text="资产查询")

        container = ttk.Frame(tab, padding=25)
        container.pack(fill=tk.BOTH, expand=True)

        input_frame = ttk.Frame(container)
        input_frame.pack(fill=tk.X, pady=15)

        ttk.Label(input_frame, text="IP:", width=10).pack(side=tk.LEFT, padx=10)
        self.ip_entry = ttk.Entry(input_frame, width=25)
        self.ip_entry.pack(side=tk.LEFT, padx=10)

        ttk.Label(input_frame, text="Domain:", width=10).pack(side=tk.LEFT, padx=10)
        self.domain_entry = ttk.Entry(input_frame, width=25)
        self.domain_entry.pack(side=tk.LEFT, padx=10)

        ttk.Label(input_frame, text="Port:", width=10).pack(side=tk.LEFT, padx=10)
        self.port_entry = ttk.Entry(input_frame, width=15)
        self.port_entry.pack(side=tk.LEFT, padx=10)

        btn = ttk.Button(input_frame, text="开始查询", command=self.perform_query, width=15)
        btn.pack(side=tk.LEFT, padx=20)

        self.result_text = scrolledtext.ScrolledText(container, height=25, font=("Consolas", 10))
        self.result_text.pack(fill=tk.BOTH, expand=True, pady=10)

        self.status_var = tk.StringVar(value="就绪")
        status_lbl = ttk.Label(container, textvariable=self.status_var)
        status_lbl.pack(anchor="w", pady=5)

    def perform_query(self):
        ip = self.ip_entry.get().strip()
        domain = self.domain_entry.get().strip()
        port = self.port_entry.get().strip()

        if not any([ip, domain, port]):
            messagebox.showwarning("输入", "请至少输入一个查询参数")
            return

        self.result_text.delete("1.0", tk.END)
        self.status_var.set("查询中...")

        threading.Thread(target=self._query_thread, args=(ip, domain, port), daemon=True).start()

    def _query_thread(self, ip, domain, port):
        results = {}
        syntax = {
            "FOFA": f'ip="{ip}"' if ip else f'domain="{domain}"' if domain else f'port="{port}"',
            "Hunter": f'ip="{ip}"' if ip else f'domain="{domain}"' if domain else f'port="{port}"',
            "Quake": f'ip:"{ip}"' if ip else f'domain:"{domain}"' if domain else f'port:"{port}"',
            "ZoomEye": f'ip="{ip}"' if ip else f'hostname="{domain}"' if domain else f'port="{port}"',
            "Shodan": f'ip:{ip}' if ip else f'hostname:"{domain}"' if domain else f'port:{port}',
            "Censys": f'ip:{ip}' if ip else f'services.http.response.html_title:*{domain}' if domain else f'services.port:{port}',
            "0.zone": f'ip={ip}' if ip else f'domain={domain}' if domain else f'port={port}',
            "BinaryEdge": f'ip:{ip}' if ip else f'host:{domain}' if domain else f'port:{port}'
        }

        for engine, query in syntax.items():
            if engine in self.apis:
                try:
                    result = self.query_engine(engine, query)
                    results[engine] = result
                except Exception as e:
                    results[engine] = f"错误: {str(e)}"

        self.root.after(0, lambda: self.display_results(results))

    def query_engine(self, engine, query):
        config = self.apis[engine]
        if engine == "FOFA":
            q_b64 = base64.b64encode(query.encode()).decode()
            url = f"https://fofa.info/api/v1/search/all?email={config['email']}&key={config['key']}&qbase64={q_b64}"
            resp = requests.get(url).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "Hunter":
            q_b64 = base64.b64encode(query.encode()).decode()
            url = f"https://hunter.qianxin.com/openapi/search?api-key={config['api_key']}&search={q_b64}"
            resp = requests.get(url).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "Quake":
            url = "https://quake.360.cn/api/v3/search/quake_service"
            headers = {"X-QuakeToken": config['token']}
            data = {"query": query, "start": 0, "size": 10}
            resp = requests.post(url, headers=headers, json=data).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "ZoomEye":
            url = f"https://api.zoomeye.org/host/search?query={query}"
            headers = {"API-KEY": config['api_key']}
            resp = requests.get(url, headers=headers).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "Shodan":
            url = f"https://api.shodan.io/shodan/host/search?key={config['api_key']}&query={query}"
            resp = requests.get(url).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "Censys":
            url = "https://search.censys.io/api/v2/hosts/search"
            auth = (config['api_id'], config['secret'])
            data = {"q": query}
            resp = requests.post(url, auth=auth, json=data).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "0.zone":
            url = f"https://0.zone/api/search?key={config['api_key']}&query={query}"
            resp = requests.get(url).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

        elif engine == "BinaryEdge":
            url = f"https://api.binaryedge.io/v2/query/search?query={query}"
            headers = {"X-Key": config['api_key']}
            resp = requests.get(url, headers=headers).json()
            return json.dumps(resp, indent=2, ensure_ascii=False)

    def display_results(self, results):
        self.result_text.delete("1.0", tk.END)
        for engine, res in results.items():
            self.result_text.insert(tk.END, f"--- {engine} 结果 ---\n{res}\n\n")
        self.status_var.set("查询完成")


