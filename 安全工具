    def load_wordlist(self):
        path = self.dict_path_var.get().strip()
        if not os.path.isfile(path):
            messagebox.showerror("错误", "请选择有效的字典文件")
            return False

        try:
            with open(path, encoding="utf-8", errors="ignore") as f:
                self.wordlist = [line.strip() for line in f if line.strip() and not line.startswith(('#', '/'))]
            self.wordlist = [p.lstrip('/') for p in self.wordlist if p.strip('/')]
            if not self.wordlist:
                messagebox.showerror("错误", "字典文件内容为空")
                return False
            self.log(f"info", f"字典加载完成：{len(self.wordlist):,} 条有效路径")
            return True
        except Exception as e:
            messagebox.showerror("读取失败", str(e))
