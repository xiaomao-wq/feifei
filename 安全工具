    def blacklist_is_valid_ip(self, ip_str):
        """验证IP地址并返回带子网掩码的格式"""
        try:
            ip = ipaddress.ip_address(ip_str)
            if ip.version == 4:
                return f"{ip_str}/32"
            elif ip.version == 6:
                return f"{ip_str}/128"
        except ValueError:
            return None

    def blacklist_process_ips(self):
        """处理IP地址"""
        ips = [ip.strip() for ip in self.blacklist_input_text.get("1.0", tk.END).splitlines() if ip.strip()]
        if not ips:
            messagebox.showwarning("警告", "请输入至少一个IP地址")
            return

        results = []
        for ip in ips:
            ip_with_mask = self.blacklist_is_valid_ip(ip)
            if ip_with_mask:
                results.append(f"{ip_with_mask},源地址,永久,{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
            else:
                results.append(f"# 无效IP: {ip}")

        self.blacklist_output_text.delete("1.0", tk.END)
        self.blacklist_output_text.insert(tk.END, "\n".join(results))
