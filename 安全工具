class ExcelReader:
    @staticmethod
    def read_excel(file_path):
        try:
            with zipfile.ZipFile(file_path) as z:
                with z.open('xl/sharedStrings.xml') as f:
                    tree = ET.parse(f)
                    root = tree.getroot()
                    texts = [''.join(t.text for t in si.iter() if t.text)
                             for si in root.findall('{http://schemas.openxmlformats.org/spreadsheetml/2006/main}si')]
                    return ' '.join(texts)
        except Exception as e:
            raise Exception(f"读取Excel文件失败: {str(e)}")

    @staticmethod
    def to_excel(data, file_path):
        try:
            header = "指令源,指令号,类型,IP/网段,下发时间,当天值班人员\n"
            rows = [
                f"{data['source']},{data['order_num']},{data['ip_type']},{ip},{data['issue_time']},{data['staff']}\n"
                for ip in data['ips']]
            with open(file_path, 'w', encoding='utf-8-sig') as f:
                f.write(header + ''.join(rows))
            return True
        except Exception as e:
            raise Exception(f"生成文件失败: {str(e)}")

    @staticmethod
    def read_column_a(file_path):
        """读取文件的A列内容（除去标题行）"""
        content_lines = []
        try:
            # 处理Excel文件
            if file_path.endswith('.xlsx'):
                with zipfile.ZipFile(file_path) as z:
                    # 获取第一个工作表
                    sheet_files = [name for name in z.namelist() if name.startswith('xl/worksheets/sheet')]
                    if not sheet_files:
                        raise Exception("未找到工作表")
                    sheet_files.sort()
                    sheet_path = sheet_files[0]

                    # 读取sharedStrings.xml
                    shared_strings = []
                    if 'xl/sharedStrings.xml' in z.namelist():
                        with z.open('xl/sharedStrings.xml') as strings_file:
                            strings_tree = ET.parse(strings_file)
                            strings_root = strings_tree.getroot()
                            ns = {'ns': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}
                            for si in strings_root.findall('ns:si', ns):
                                texts = [t.text for t in si.findall('.//ns:t', ns) if t.text]
                                shared_strings.append(''.join(texts))

                    # 读取工作表内容
                    with z.open(sheet_path) as f:
                        tree = ET.parse(f)
                        root = tree.getroot()
                        ns = {'ns': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}
                        rows = root.findall('.//ns:row', ns)
                        # 跳过第一行（标题行）
                        for row in rows[1:]:
                            # 查找A列单元格
                            a_cell = None
                            for cell in row.findall('ns:c', ns):
                                cell_r = cell.get('r')
                                if cell_r and cell_r.startswith('A'):
                                    a_cell = cell
                                    break
                            if a_cell is None:
                                continue
                            # 获取单元格的值
                            value_elem = a_cell.find('ns:v', ns)
                            if value_elem is None or value_elem.text is None:
                                continue
                            value = value_elem.text
                            # 如果是共享字符串类型
                            if a_cell.get('t') == 's':
                                try:
                                    idx = int(value)
                                    value = shared_strings[idx]
                                except (ValueError, IndexError):
                                    pass
                            content_lines.append(value.strip())

            # 处理文本文件（.txt, .csv等）
            else:
                with open(file_path, 'r', encoding='utf-8') as f:
                    lines = f.readlines()
                    # 跳过第一行（标题行）
                    for line in lines[1:]:
                        # 如果是CSV，按逗号分割取第一列
                        if file_path.endswith('.csv'):
                            parts = line.split(',')
                            if parts:
                                content_lines.append(parts[0].strip())
                        else:  # 其他文本文件，直接取整行
                            content_lines.append(line.strip())
        except Exception as e:
            raise Exception(f"读取文件A列内容失败: {str(e)}")
        return content_lines


def extract_ips(text):
    ip_pattern = r'\b(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?\b'
    return re.findall(ip_pattern, text)


def filter_ips_by_whitelist(ips, whitelist):
    if not whitelist:
        return ips, []
    whitelist_ips = [ip.strip() for ip in whitelist.split('\n') if ip.strip()]
    filtered_ips = []
    matched_ips = []
    for ip in ips:
        if not any(w_ip in ip for w_ip in whitelist_ips):
            filtered_ips.append(ip)
        else:
            matched_ips.append(ip)
    return filtered_ips, matched_ips


