    def create_tooltip(self, widget, text):
        """创建简单的工具提示"""

        def enter(event):
            self.status_var.set(text)

        def leave(event):
            self.status_var.set("就绪 - 点击上方按钮使用工具")

        widget.bind("<Enter>", enter)
        widget.bind("<Leave>", leave)

