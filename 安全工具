    # ================== 图片处理功能 ==================
    def handle_paste(self, event):
        """处理粘贴事件"""
        try:
            # 尝试获取图片
            image = self.get_clipboard_image()
            if image:
                self.add_image(image)
                return
        except Exception as e:
            print(f"图片粘贴错误: {e}")

        try:
            # 尝试获取文件
            files = self.get_clipboard_files()
            if files:
                self.add_files(files)
        except Exception as e:
            print(f"文件粘贴错误: {e}")

    def get_clipboard_image(self):
        """从剪贴板获取图片"""
        try:
            # 仅支持Windows
            if sys.platform == 'win32':
                import win32clipboard
                from PIL import ImageGrab

                win32clipboard.OpenClipboard()
                if win32clipboard.IsClipboardFormatAvailable(win32clipboard.CF_DIB):
                    image = ImageGrab.grabclipboard()
                    if image:
                        return image
                win32clipboard.CloseClipboard()
            else:
                # 对于非Windows系统，尝试使用Tkinter方法
                try:
                    # 尝试获取PNG格式的图片
                    image_data = self.root.clipboard_get(type='image/png')
                    if image_data:
                        # 解码base64图片数据
                        if image_data.startswith('data:image/png;base64,'):
                            image_data = image_data.split(',', 1)[1]
                        image_bytes = base64.b64decode(image_data)
                        return Image.open(io.BytesIO(image_bytes))
                except:
                    pass
        except ImportError:
            pass
        return None

    def add_image(self, image):
        """添加图片到预览区域"""
        try:
            # 创建缩略图用于预览
            thumbnail = image.copy()
            thumbnail.thumbnail((60, 60), Image.LANCZOS)  # 减小缩略图尺寸

            # 添加边框
            thumbnail_with_border = ImageOps.expand(thumbnail, border=1, fill='gray')

            tk_image = ImageTk.PhotoImage(thumbnail_with_border)

            # 创建图片预览框
            frame = ttk.Frame(self.image_preview_frame)
            frame.pack(side=tk.LEFT, padx=3, pady=3, fill=tk.Y)

            label = ttk.Label(frame, image=tk_image)
            label.image = tk_image  # 保持引用
            label.pack()

            # 添加删除按钮
            ttk.Button(frame, text="删除", width=6,
                       command=lambda f=frame, img=image: self.remove_image(f, img)).pack()

            # 保存原始图片
            self.image_list.append({
                "image": image,
                "frame": frame
            })

            self.status_label.config(text="图片已添加")
        except Exception as e:
            self.status_label.config(text=f"图片添加失败: {str(e)}")

    def add_image_files(self):
        """通过文件对话框添加图片文件"""
        files = filedialog.askopenfilenames(
            title="选择图片文件",
            filetypes=[("图片文件", "*.png *.jpg *.jpeg *.bmp *.gif"), ("所有文件", "*.*")]
        )
        if not files:
            return

        for file_path in files:
            try:
                image = Image.open(file_path)
                self.add_image(image)
            except Exception as e:
                self.status_label.config(text=f"无法加载图片: {file_path} - {str(e)}")

    def remove_image(self, frame, image):
        """移除指定图片"""
        frame.destroy()

        # 从列表中移除
        for idx, img_info in enumerate(self.image_list):
            if img_info["image"] == image:
                self.image_list.pop(idx)
                break

    def clear_images(self):
        """清空所有图片"""
        for img_info in self.image_list[:]:
            try:
                img_info["frame"].destroy()
            except:
                pass

        self.image_list = []
        self.status_label.config(text="图片已清空")

    def save_images(self, picture_folder):
        """保存所有图片到指定文件夹"""
        if not self.image_list:
            return 0

        if not os.path.exists(picture_folder):
            os.makedirs(picture_folder)

        for i, img_info in enumerate(self.image_list, 1):
            img_path = os.path.join(picture_folder, f"告警_{i}.png")
            img_info["image"].save(img_path, "PNG")

        return len(self.image_list)

    # ================== 文件处理功能 ==================
    def get_clipboard_files(self):
        """从剪贴板获取文件列表"""
        files = []
        try:
            # 仅支持Windows
            if sys.platform == 'win32':
                import win32clipboard
                import win32con

                win32clipboard.OpenClipboard()
                if win32clipboard.IsClipboardFormatAvailable(win32con.CF_HDROP):
                    files = win32clipboard.GetClipboardData(win32con.CF_HDROP)
                win32clipboard.CloseClipboard()
            else:
                # 对于非Windows系统，尝试使用Tkinter方法
                try:
                    # 尝试获取文件路径
                    file_path = self.root.clipboard_get()
                    if file_path and os.path.exists(file_path):
                        files = [file_path]
                except:
                    pass
        except ImportError:
            pass
        return files

    def add_files(self, files=None):
        """添加文件到列表"""
        if files is None:
            files = filedialog.askopenfilenames(
                title="选择文件",
                filetypes=[("支持的文件", "*.csv *.txt *.xls *.xlsx *.zip *.png *.jpg *.jpeg *.bmp"),
                           ("所有文件", "*.*")]
            )

        if not files:
            return

        valid_extensions = ('.csv', '.txt', '.xls', '.xlsx', '.zip', '.png', '.jpg', '.jpeg', '.bmp')
        added = False

        for file_path in files:
            # 检查文件是否存在
            if not os.path.exists(file_path):
                continue

            ext = os.path.splitext(file_path)[1].lower()
            if ext in valid_extensions:
                # 避免重复添加
                if file_path not in self.file_listbox.get(0, tk.END):
                    self.file_listbox.insert(tk.END, file_path)
                    added = True

        if added:
            self.status_label.config(text="文件已添加")
        else:
            self.status_label.config(text="未添加文件: 不支持的文件类型或文件不存在")

    def remove_selected_file(self):
        """移除选中的文件"""
        selected = self.file_listbox.curselection()
        if selected:
            self.file_listbox.delete(selected[0])

    def clear_files(self):
        """清空文件列表"""
        self.file_listbox.delete(0, tk.END)

    def save_files(self, log_folder):
        """智能保存文件：zip文件直接复制，其他文件压缩成zip，使用第一个日志文件名作为压缩包名"""
        if self.file_listbox.size() == 0:
            return 0

        if not os.path.exists(log_folder):
            os.makedirs(log_folder)

        zip_files = []
        non_zip_files = []

        # 分类文件
        for i in range(self.file_listbox.size()):
            file_path = self.file_listbox.get(i)
            if os.path.exists(file_path):
                if file_path.lower().endswith('.zip'):
                    zip_files.append(file_path)
                else:
                    non_zip_files.append(file_path)

        # 处理zip文件 - 直接复制
        zip_count = 0
        for file_path in zip_files:
            try:
                dest_path = os.path.join(log_folder, os.path.basename(file_path))
                shutil.copy2(file_path, dest_path)
                zip_count += 1
            except Exception as e:
                self.status_label.config(text=f"保存ZIP文件失败: {os.path.basename(file_path)} - {str(e)}")

        # 处理非zip文件 - 压缩
        non_zip_count = 0
        if non_zip_files:
            # 使用第一个日志文件的文件名（不含扩展名）作为压缩包名
            first_file = non_zip_files[0]
            first_file_name = os.path.splitext(os.path.basename(first_file))[0]
            zip_path = os.path.join(log_folder, f"{first_file_name}.zip")

            try:
                with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
                    for file_path in non_zip_files:
                        arcname = os.path.basename(file_path)
                        zipf.write(file_path, arcname)
                        non_zip_count += 1
            except Exception as e:
                self.status_label.config(text=f"创建压缩文件失败: {str(e)}")

        return zip_count + non_zip_count

    # ================== 表单验证功能 ==================
    def validate_ip_and_query(self, event=None):
        """验证IP格式并自动查询归属地"""
        widget = event.widget if event else None
        if not widget:
            return

        # 获取IP并去除空格、回车、tab
        original_text = widget.get()
        cleaned_text = original_text.strip().replace('\r', '').replace('\n', '').replace('\t', '')

        # 如果内容有变化，更新输入框
        if cleaned_text != original_text:
            widget.delete(0, tk.END)
            widget.insert(0, cleaned_text)

        ip = cleaned_text
        is_attack = (widget == self.entry_attack_ip)

        # 验证IP格式
        if self.validate_ip_target(widget):
            # 启动查询线程
            threading.Thread(target=self.query_ip_location, args=(is_attack, ip)).start()
        else:
            self.status_label.config(text=f"IP地址格式无效: {ip}")

    def query_ip_location(self, is_attack=True, ip=None):
        """查询IP归属地"""
        try:
            # 获取IP地址
            if ip is None:
                if is_attack:
                    ip = self.entry_attack_ip.get()
                else:
                    ip = self.entry_target_ip.get()

            # 验证IP格式
            try:
                ipaddress.ip_address(ip)
            except ValueError:
                self.status_label.config(text=f"IP地址格式无效: {ip}")
                return

            # 更新状态
            self.status_label.config(text=f"正在查询 {ip} 的归属地...")
            self.root.update()

            headers = {
                "Accept": "application/json, text/javascript, */*; q=0.01",
                "Accept-Encoding": "gzip, deflate, br, zstd",
                "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6",
                "Cache-Control": "no-cache",
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "Origin": "https://uutool.cn",
                "Pragma": "no-cache",
                "Priority": "u=1, i",
                "Referer": "https://uutool.cn/",
                "Sec-Ch-Ua": '"Not)A;Brand";v="8", "Chromium";v="138", "Microsoft Edge";v="138"',
                "Sec-Ch-Ua-Mobile": "?0",
                "Sec-Ch-Ua-Platform": '"Windows"',
                "Sec-Fetch-Dest": "empty",
                "Sec-Fetch-Mode": "cors",
                "Sec-Fetch-Site": "cross-site",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36 Edg/138.0.0.0"
            }

            payload = {"ip": ip}

            try:
                response = requests.post(
                    "https://api.ip77.net/ip2/v4/",
                    data=payload,
                    headers=headers,
                    verify=False,
                    impersonate="chrome110"  # 模拟 Chrome 浏览器指纹
                )

                if response.status_code == 200:
                    # 解析JSON响应
                    try:
                        data = response.json()
                        # 检查响应格式是否正确
                        if data.get("code") == 0:
                            location_data = data.get("data", {})
                            country = location_data.get("country", "")
                            province = location_data.get("province", "")

                            # 如果是中国IP，自动填写省份；否则只填写国家
                            if country == "中国" and province:
                                self.root.after(0, self.update_location_fields, is_attack, country, province)
                                self.status_label.config(text=f"查询成功: {ip} 归属地为 {country} {province}")
                            else:
                                self.root.after(0, self.update_location_fields, is_attack, country, "")
                                self.status_label.config(text=f"查询成功: {ip} 归属地为 {country}")
                        else:
                            self.status_label.config(text=f"查询失败: 接口返回错误码 {data.get('code')}")
                    except json.JSONDecodeError:
                        self.status_label.config(text=f"解析响应失败: 非JSON格式")
                else:
                    self.status_label.config(text=f"查询失败: HTTP {response.status_code}")

            except Exception as e:
                self.status_label.config(text=f"查询错误: {str(e)}")

        except Exception as e:
            self.status_label.config(text=f"查询异常: {str(e)}")

