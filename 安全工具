    def copy_ips_from_file(self, index):
        """从文件中提取A列内容并复制到剪贴板（不包括标题行）"""
        panel = self.multi_panels[index]
        if not panel['file_path']:
            messagebox.showwarning("提示", "请先选择文件")
            return

        try:
            content_lines = ExcelReader.read_column_a(panel['file_path'])
            if not content_lines:
                messagebox.showinfo("提示", "文件中未找到A列内容")
                return

            content = "\n".join(content_lines)

            # 复制到剪贴板
            self.root.clipboard_clear()
            self.root.clipboard_append(content)
            self.root.update()  # 确保剪贴板更新

            # 显示成功消息
            messagebox.showinfo("成功", f"已复制{len(content_lines)}条A列内容到剪贴板")

        except Exception as e:
            messagebox.showerror("错误", f"读取文件时出错: {str(e)}")

    def multi_select_file(self, index):
        file_path = filedialog.askopenfilename(
            filetypes=[("Excel Files", "*.xlsx"), ("Text Files", "*.txt"), ("CSV Files", "*.csv")])
        if file_path:
            self.multi_panels[index]['file_path'] = file_path
            filename = os.path.basename(file_path)
            filename_without_ext = os.path.splitext(filename)[0]
            self.multi_panels[index]['file_label'].config(text=filename, fg=T_TEXT_COLOR)
            self.multi_panels[index]['order_num'].delete(0, tk.END)
            self.multi_panels[index]['order_num'].insert(0, filename_without_ext)

    def multi_merge_files(self):
        all_data = []
        all_content_lines = []  # 存储所有A列内容用于汇总标签页

        # 获取全局值班人员信息
        global_staff = self.global_staff_entry.get().strip()
        if not global_staff:
            messagebox.showerror("错误", "请输入值班人员信息")
            return

        for panel in self.multi_panels:
            if not panel['file_path']:
                continue

            try:
                # 读取A列内容（除去标题行）
                content_lines = ExcelReader.read_column_a(panel['file_path'])
                if not content_lines:
                    messagebox.showwarning("提示", f"文件 {os.path.basename(panel['file_path'])} 中未找到A列内容")
                    continue

                if not panel['order_num'].get():
                    messagebox.showerror("错误",
                                         f"请填写文件 {os.path.basename(panel['file_path'])} 的指令号")
                    return

                # 存储数据用于导出
                all_data.append({
                    'ips': content_lines,  # 使用A列内容作为IP/网段字段
                    'source': panel['source_var'].get(),
                    'order_num': panel['order_num'].get(),
                    'ip_type': panel['type_var'].get(),
                    'issue_time': panel['issue_time'].get(),
                    'staff': global_staff  # 使用全局值班人员信息
                })

                # 添加到汇总列表
                all_content_lines.extend(content_lines)

            except Exception as e:
                messagebox.showerror("错误", f"处理文件 {os.path.basename(panel['file_path'])} 时出错: {str(e)}")
                return

        if not all_data:
            messagebox.showwarning("提示", "没有有效数据可导出")
            return

        # 导出为CSV文件
        save_path = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV Files", "*.csv")])
        if not save_path:
            return

        try:
            with open(save_path, 'w', encoding='utf-8-sig') as f:
                f.write("指令源,指令号,类型,IP/网段,下发时间,当天值班人员\n")
                for data in all_data:
                    for ip in data['ips']:
                        f.write(
                            f"{data['source']},{data['order_num']},{data['ip_type']},{ip},{data['issue_time']},{data['staff']}\n")
            messagebox.showinfo("成功", f"文件已合并保存到: {save_path}")
        except Exception as e:
            messagebox.showerror("错误", f"保存文件时出错: {str(e)}")

