class CyberSecurityToolkit:
    def __init__(self, root):
        self.root = root
        self.root.title("网络安全综合工具箱 2025")
        self.root.geometry("1200x700")

        # 设置窗口居中
        self.center_window(1200, 700)

        self.root.resizable(True, True)

        # 设置窗口图标
        try:
            self.root.iconbitmap('icon.ico')
        except:
            pass

        # 初始化背景相关变量
        self.bg_image = None
        self.bg_photo = None
        self.bg_label = None
        self.blur_intensity = 20  # 默认模糊度

        # 创建菜单栏
        self.create_menu()

        # 创建控件
        self.create_widgets()

        # 绑定窗口大小变化事件
        self.root.bind('<Configure>', self.on_window_resize)

        # 尝试加载默认背景
        self.try_load_default_bg()

    def center_window(self, width, height):
        """将窗口居中显示"""
        screen_width = self.root.winfo_screenwidth()
        screen_height = self.root.winfo_screenheight()
        x = (screen_width - width) // 2
        y = (screen_height - height) // 2
        self.root.geometry(f'{width}x{height}+{x}+{y}')

    def create_menu(self):
        """创建菜单栏"""
        menubar = tk.Menu(self.root)
        self.root.config(menu=menubar)

        # 视图菜单
        view_menu = tk.Menu(menubar, tearoff=0)
        menubar.add_cascade(label="视图", menu=view_menu)
        view_menu.add_command(label="设置背景图片", command=self.set_background)
        view_menu.add_command(label="清除背景", command=self.clear_background)
        view_menu.add_separator()

        # 模糊度子菜单
        blur_menu = tk.Menu(view_menu, tearoff=0)
        view_menu.add_cascade(label="背景模糊度", menu=blur_menu)
        blur_menu.add_command(label="无模糊", command=lambda: self.set_blur(0))
        blur_menu.add_command(label="轻度模糊", command=lambda: self.set_blur(10))
        blur_menu.add_command(label="中度模糊", command=lambda: self.set_blur(20))
        blur_menu.add_command(label="重度模糊", command=lambda: self.set_blur(30))

        view_menu.add_separator()
        view_menu.add_command(label="退出", command=self.root.quit)

    def try_load_default_bg(self):
        """尝试加载默认背景图片"""
        default_paths = [
            "background.jpg",
            "background.png",
            "bg.jpg",
            "bg.png",
            os.path.join("images", "background.jpg"),
            os.path.join("images", "background.png")
        ]

        for path in default_paths:
            if os.path.exists(path):
                self.set_background(path)
                break

    def set_background(self, image_path=None):
        """设置背景图片"""
        if not image_path:
            filetypes = [
                ("图片文件", "*.jpg *.jpeg *.png *.bmp *.gif"),
                ("所有文件", "*.*")
            ]
            image_path = filedialog.askopenfilename(
                title="选择背景图片",
                filetypes=filetypes
            )
            if not image_path:
                return

        try:
            # 加载图片
            image = Image.open(image_path)

            # 获取窗口尺寸
            window_width = self.root.winfo_width()
            window_height = self.root.winfo_height()

            # 如果窗口尺寸太小，使用默认尺寸
            if window_width < 100 or window_height < 100:
                window_width = 1200
                window_height = 700

            # 调整图片大小以适应窗口
            image = image.resize((window_width, window_height), Image.Resampling.LANCZOS)

            # 应用模糊效果
            if self.blur_intensity > 0:
                image = image.filter(ImageFilter.GaussianBlur(self.blur_intensity))

            # 转换为PhotoImage
            self.bg_photo = ImageTk.PhotoImage(image)

            # 创建或更新背景标签
            if self.bg_label:
                self.bg_label.config(image=self.bg_photo)
            else:
                self.bg_label = tk.Label(self.root, image=self.bg_photo)
                self.bg_label.place(x=0, y=0, relwidth=1, relheight=1)
                # 将背景层发送到底层
                self.bg_label.lower()

            # 保存引用防止被垃圾回收
            self.bg_image = image

        except Exception as e:
            messagebox.showerror("错误", f"加载背景图片失败: {str(e)}")

    def set_blur(self, intensity):
        """设置模糊程度"""
        self.blur_intensity = intensity
        if self.bg_image:
            # 重新加载原始图片并应用新的模糊度
            try:
                image_path = self.bg_image.filename
                self.set_background(image_path)
            except:
                pass

    def clear_background(self):
        """清除背景图片"""
        if self.bg_label:
            self.bg_label.destroy()
            self.bg_label = None
        self.bg_image = None
        self.bg_photo = None

    def on_window_resize(self, event):
        """窗口大小变化时重新调整背景图片"""
        if self.bg_image and event.widget == self.root:
            self.root.after(100, self.update_background)

    def update_background(self):
        """更新背景图片尺寸"""
        if self.bg_image:
            try:
                image_path = self.bg_image.filename
                self.set_background(image_path)
            except:
                pass

