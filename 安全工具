    def log(self, tag, msg):
        timestamp = datetime.now().strftime("%H:%M:%S")
        line = f"[{timestamp}] {msg}"
        self.result_queue.put((tag, line))

    def start_scan(self):
        if self.is_running:
            return

        target = self.url_entry.get().strip()
        if not target:
            messagebox.showwarning("提示", "请输入目标网址")
            return

        if not target.startswith(("http://", "https://")):
            target = "https://" + target
            self.url_entry.delete(0, tk.END)
            self.url_entry.insert(0, target)

        if not self.load_wordlist():
            return

        try:
            concurrency = int(self.concurrency_var.get())
            timeout = float(self.timeout_var.get())
        except:
            messagebox.showwarning("提示", "并发数 / 超时请输入有效数字")
            return

        self.is_running = True
        self.task_cancel = False
        self.start_btn.config(state=tk.DISABLED)
        self.stop_btn.config(state=tk.NORMAL)
        self.status_var.set("正在初始化异步扫描...")
        self.progress['value'] = 0
        self.progress['maximum'] = len(self.wordlist)

        self.result_text.delete(1.0, tk.END)
        self.log("info", f"目标 → {target}")
        self.log("info", f"并发 → {concurrency} | 超时 → {timeout}s | 总路径 → {len(self.wordlist):,}\n")

        threading.Thread(
            target=lambda: asyncio.run(self.async_scan_worker(target, concurrency, timeout)),
            daemon=True
        ).start()

        self.root.after(400, self.process_queue)

    def stop_scan(self):
        if self.is_running:
            self.task_cancel = True
            self.status_var.set("正在停止... 请稍候")
            self.log("info", "收到停止指令，正在取消任务...")

    async def async_scan_worker(self, base_url, concurrency, timeout):
        connector = aiohttp.TCPConnector(limit=concurrency + 20, force_close=False)
        async with aiohttp.ClientSession(connector=connector) as session:
            tasks = []
            total = len(self.wordlist)
            done_count = 0

            for path in self.wordlist:
                if self.task_cancel:
                    break
                tasks.append(self.scan_one(session, base_url, path, timeout))

                if len(tasks) >= concurrency * 2:
                    results = await asyncio.gather(*tasks, return_exceptions=True)
                    for r in results:
                        if not self.task_cancel:
                            self.handle_result(r, done_count, total)
                            done_count += 1
                    tasks = []

            if tasks and not self.task_cancel:
                results = await asyncio.gather(*tasks, return_exceptions=True)
                for r in results:
                    self.handle_result(r, done_count, total)
                    done_count += 1

        self.result_queue.put(("info", "\n" + "=" * 70))
        if self.task_cancel:
            self.result_queue.put(("info", "扫描被用户手动终止"))
        else:
            self.result_queue.put(("info", f"扫描完成！总共处理 {done_count:,} / {total:,} 条路径"))
        self.result_queue.put(("done", None))

    async def scan_one(self, session, base_url, path, timeout):
        url = urljoin(base_url.rstrip("/") + "/", path)
        try:
            start = time.time()
            async with session.get(url, timeout=aiohttp.ClientTimeout(total=timeout), allow_redirects=False) as resp:
                status = resp.status
                size = 0
                try:
                    content = await resp.read()
                    size = len(content)
                except:
                    pass
                elapsed = time.time() - start
                return (status, url, size, elapsed, path)
        except Exception as e:
            return ("error", url, 0, 0, path, str(e)[:60])

    def handle_result(self, result, done, total):
        if isinstance(result, Exception):
            return

        if result[0] == "error":
            tag = "error"
            line = f"[ERR ] {result[1]} → {result[5]}"
        else:
            status, url, size, elapsed, path = result
            tag = str(status) if str(status).startswith("20") else \
                "30x" if 300 <= status < 400 else \
                    str(status) if status == 403 else \
                        "404" if status == 404 else \
                            "50x" if 500 <= status < 600 else "other"

            line = f"[{status:4d}] {url:<75} {size:>8,} b   {elapsed:>5.2f}s"

        self.result_queue.put((tag, line))
        self.result_queue.put(("progress", done + 1))

    def process_queue(self):
        try:
            while True:
                item = self.result_queue.get_nowait()
                tag, value = item

                if tag == "progress":
                    self.progress['value'] = value
                    self.status_var.set(
                        f"扫描中... {value:,} / {len(self.wordlist):,} ({value / len(self.wordlist) * 100:.1f}%)")
                elif tag == "done":
                    self.is_running = False
                    self.start_btn.config(state=tk.NORMAL)
                    self.stop_btn.config(state=tk.DISABLED)
                    self.status_var.set("扫描结束" if not self.task_cancel else "已停止")
                    self.progress.stop()
                    break
                else:
                    self.result_text.insert(tk.END, value + "\n", tag)
                    self.result_text.see(tk.END)
        except queue.Empty:
            pass

        if self.is_running:
            self.root.after(250, self.process_queue)

    def clear_result(self):
        if not self.is_running:
            self.result_text.delete(1.0, tk.END)
            self.progress['value'] = 0
            self.status_var.set("就绪")


