            return

        # 清空之前的高亮
        self.unblock_text.tag_remove("red", "1.0", "end")

        # 过滤出仍然需要封禁的IP
        remaining_banned = []
        matched_ips = []

        # 遍历所有解封IP
        for unblock_ip in unblock_ips:
            # 在解封文本框中查找并高亮匹配项
            start_index = "1.0"
            while True:
                pos = self.unblock_text.search(unblock_ip, start_index, stopindex=tk.END)
