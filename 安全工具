    def filter_unblock_ips(self):
        """执行解封IP过滤"""
        # 获取封禁IP列表
        banned_ips = [ip.strip() for ip in self.banned_text.get('1.0', tk.END).splitlines() if ip.strip()]
        if not banned_ips:
