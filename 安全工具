            side=tk.LEFT, padx=10)

        output_lbl = ttk.Label(container, text="结果：")
        output_lbl.pack(anchor="w", pady=(10, 5))

        self.enc_out = scrolledtext.ScrolledText(container, height=10, font=("Consolas", 10))
        self.enc_out.pack(fill=tk.BOTH, expand=True)

    def do_encode(self):
        text = self.enc_in.get("1.0", tk.END).strip()
        mode = self.enc_mode.get()
        try:
            if mode == "Base64":
                res = base64.b64encode(text.encode()).decode()
            elif mode == "Base32":
                res = base64.b32encode(text.encode()).decode()
            elif mode == "Hex":
                res = binascii.hexlify(text.encode()).decode()
            elif mode == "URL":
                res = quote(text)
            elif mode == "HTML Escape":
                res = html.escape(text)
            elif mode == "Unicode Esc":
                res = text.encode("unicode_escape").decode()
            else:
                res = "未知模式"
            self.enc_out.delete("1.0", tk.END)
            self.enc_out.insert(tk.END, res)
        except Exception as e:
            messagebox.showerror("编码错误", str(e))

    def do_decode(self):
        text = self.enc_in.get("1.0", tk.END).strip()
        mode = self.enc_mode.get()
        try:
            if mode == "Base64":
                text += "=" * (-len(text) % 4)
                res = base64.b64decode(text).decode(errors="replace")
            elif mode == "Base32":
                text += "=" * (-len(text) % 8)
                res = base64.b32decode(text).decode(errors="replace")
            elif mode == "Hex":
                res = binascii.unhexlify(text).decode(errors="replace")
            elif mode == "URL":
                res = unquote(text)
            elif mode == "HTML Escape":
                res = html.unescape(text)
            elif mode == "Unicode Esc":
                res = bytes(text, "utf-8").decode("unicode_escape")
            else:
                res = "未知模式"
            self.enc_out.delete("1.0", tk.END)
            self.enc_out.insert(tk.END, res)
        except Exception as e:
            messagebox.showerror("解码错误", str(e))

