                # 打开模板文件
                book = load_workbook(template_file)
                sheet = book.active

                # 直接修改第二行的数据
                for col_idx, value in enumerate(new_row, 1):
                    sheet.cell(row=2, column=col_idx, value=value)

                # 保存文件
                try:
                    book.save(output_file)
                except PermissionError as e:
                    # 如果权限错误，尝试创建备份文件
                    backup_file = "./安全事件备份.xlsx"
                    book.save(backup_file)
                    messagebox.showinfo("成功", f"由于权限问题，已创建备份文件: {backup_file}")
