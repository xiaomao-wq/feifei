    def is_ip_in_whitelist(self, ip_str, whitelist):
        """检查IP是否匹配白名单规则"""
        try:
            ip = ipaddress.ip_address(ip_str.strip())
            for entry in whitelist:
                entry = entry.strip()
                if not entry or entry.startswith('#'):
                    continue
                try:
                    network = ipaddress.ip_network(entry, strict=False)
                    if ip in network:
                        return True, entry
                except ValueError:
                    if entry == ip_str:
                        return True, entry
        except ValueError:
            return False, None
        return False, None

    def highlight_whitelist_entry(self, entry):
        """高亮显示白名单中的匹配条目并自动定位"""
        self.whitelist_text.tag_remove('highlight', '1.0', tk.END)

        content = self.whitelist_text.get('1.0', tk.END)
        start_idx = '1.0'
        found_positions = []

        while True:
            start_idx = self.whitelist_text.search(
                entry,
                start_idx,
                tk.END,
                exact=True,
                regexp=False
            )
            if not start_idx:
                break

            end_idx = f"{start_idx}+{len(entry)}c"
            self.whitelist_text.tag_add('highlight', start_idx, end_idx)
            found_positions.append(start_idx)
            start_idx = end_idx

        if found_positions:
            self.whitelist_text.see(found_positions[0])
            return True
        return False

    def filter_ips(self, event=None):
        """执行过滤操作"""
        # 清空之前的高亮
        self.whitelist_text.tag_remove('highlight', '1.0', tk.END)

        # 获取输入内容
        input_content = self.input_text.get('1.0', tk.END)
        input_ips = [ip.strip() for ip in input_content.splitlines() if ip.strip()]

        if not input_ips:
            messagebox.showwarning("提示", "请输入要过滤的IP地址！")
            return

        # 获取白名单条目（过滤掉空行和注释）
        whitelist_content = self.whitelist_text.get('1.0', tk.END)
        whitelist_entries = [e.strip() for e in whitelist_content.splitlines()
                             if e.strip() and not e.strip().startswith('#')]

        if not whitelist_entries:
            messagebox.showwarning("提示", "白名单为空，请添加白名单条目！")
            return

        # 过滤非白名单IP
        non_whitelist = []
        matched_entries = set()
        has_match = False

        for ip in input_ips:
            is_match, matched_entry = self.is_ip_in_whitelist(ip, whitelist_entries)
            if not is_match:
                non_whitelist.append(ip)
            elif matched_entry:
                matched_entries.add(matched_entry)
                # 高亮显示匹配项
                if self.highlight_whitelist_entry(matched_entry):
                    has_match = True

        # 更新输出框
        self.output_text.config(state='normal')
        self.output_text.delete('1.0', tk.END)
        self.output_text.insert('1.0', '\n'.join(non_whitelist))
        self.output_text.config(state='disabled')
        self.update_output_counter(len(non_whitelist))

        # 显示结果消息
        if matched_entries:
            if len(matched_entries) > 3:
                match_msg = f"找到 {len(matched_entries)} 个匹配的白名单条目"
            else:
                match_msg = f"匹配的白名单条目: {', '.join(matched_entries)}"

            messagebox.showinfo(
                "过滤完成",
                f"{match_msg}\n非白名单IP数量: {len(non_whitelist)}"
            )
        else:
            messagebox.showinfo(
                "过滤完成",
                f"所有输入的IP都不在白名单中\n非白名单IP数量: {len(non_whitelist)}"
            )

