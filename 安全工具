        """保存到CSV文件"""
        if not hasattr(self, 'valid_results'):
            messagebox.showwarning("警告", "请先处理IP地址")
            return

        try:
            # 检查/创建文件
            file_exists = os.path.exists(self.blacklist_path)
            with open(self.blacklist_path, 'a', newline='', encoding='utf-8-sig') as f:
                writer = csv.writer(f)

                # 新文件才写入表头
