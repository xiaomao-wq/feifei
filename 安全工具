    def aes_encrypt(self):
        if not self.aes_key:
            messagebox.showwarning("提示", "请先生成密钥")
            return
        try:
            data = self.aes_in.get("1.0", tk.END).strip().encode()
            cipher = AES.new(self.aes_key, AES.MODE_CBC)
            ct = cipher.encrypt(pad(data, AES.block_size))
            result = base64.b64encode(cipher.iv + ct).decode()
            self.aes_out.delete("1.0", tk.END)
            self.aes_out.insert(tk.END, f"IV + 密文 (Base64):\n{result}")
        except Exception as e:
            messagebox.showerror("AES加密失败", str(e))

    def aes_decrypt(self):
        if not self.aes_key:
            messagebox.showwarning("提示", "请先生成密钥")
            return
        try:
            data = base64.b64decode(self.aes_in.get("1.0", tk.END).strip())
            iv = data[:16]
            ct = data[16:]
            cipher = AES.new(self.aes_key, AES.MODE_CBC, iv)
            pt = unpad(cipher.decrypt(ct), AES.block_size)
            self.aes_out.delete("1.0", tk.END)
            self.aes_out.insert(tk.END, pt.decode(errors="replace"))
        except Exception as e:
            messagebox.showerror("AES解密失败", str(e))

    def gen_rsa(self):
        key = RSA.generate(2048)
        self.rsa_key_pair = key
        priv = key.export_key().decode()
        pub = key.publickey().export_key().decode()
        msg = (
            "已生成 2048 位 RSA 密钥对（仅本次会话有效）\n\n"
            f"公钥（前100字符）:\n{pub[:100]}...\n\n"
            f"私钥（前100字符）:\n{priv[:100]}..."
        )
        messagebox.showinfo("RSA 密钥生成", msg)

