        mode = self.port_mode.get()

        if custom_str:
            try:
                ports = [int(p.strip()) for p in custom_str.split(",") if p.strip().isdigit()]
                if not ports:
                    raise ValueError
            except:
                messagebox.showwarning("提示", "自定义端口格式错误")
                return
        else:
            if mode == "top100":
                ports = TOP100_PORTS
            elif mode == "top1000":
                ports = TOP1000_PORTS
            elif mode == "common":
                ports = COMMON_PORTS
            elif mode == "rce":
                ports = RCE_RELATED_PORTS
            elif mode == "all":
                if not messagebox.askyesno("警告", "全端口扫描非常耗时且可能被拦截，确定继续？"):
                    return
                ports = ALL_PORTS
            else:
                ports = COMMON_PORTS

        timeout = self.timeout_var.get()
        max_workers = self.threads_var.get()

        if max_workers < 10:
            max_workers = 10
        if max_workers > 1500:
            max_workers = 1500

        self.result_text.delete("1.0", tk.END)
        self.running = True
        self.btn_start.config(text="停止扫描")
        self.status_var.set(f"正在扫描 {target} ... 并发: {max_workers}")

        threading.Thread(
            target=self.scan_with_threadpool,
            args=(target, ports, timeout, max_workers),
            daemon=True
        ).start()

        self.root.after(100, self.update_ui)

    def scan_port(self, target, port, timeout):
        if not self.running:
            return None

        is_open = False
        banner = ""
        protocol = "TCP"

        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            result = sock.connect_ex((target, port))

            if result == 0:
                is_open = True

                try:
                    sock.settimeout(0.8)
                    data = sock.recv(1024).decode(errors='ignore').strip()
                    if data:
                        banner = data.splitlines()[0][:70]
                except:
                    pass

                if port in (80, 8080, 8000, 8888, 9000):
                    protocol = "HTTP"
                elif port in (443, 8443):
                    protocol = "HTTPS"
                elif port == 22:
                    protocol = "SSH"
                elif port == 21:
                    protocol = "FTP"
                elif port == 3306:
                    protocol = "MySQL"
                elif port == 6379:
                    protocol = "Redis"
                elif port == 27017:
                    protocol = "MongoDB"

            sock.close()

        except:
            pass

        if is_open:
            banner_show = banner if banner else "无banner"
            return f"{port:6}  open    {protocol:<8}  {banner_show}"
        return None

    def scan_with_threadpool(self, target, ports, timeout, max_workers):
        total = len(ports)
        found = 0
        self.log(f"目标: {target}")
        self.log(f"端口总数: {total:,}")
        self.log(f"并发线程: {max_workers}")
        self.log(f"超时: {timeout}s\n")

        results = []

        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
            future_to_port = {
                executor.submit(self.scan_port, target, port, timeout): port
                for port in ports
            }

            for future in concurrent.futures.as_completed(future_to_port):
                if not self.running:
                    executor.shutdown(wait=False, cancel_futures=True)
                    self.log("\n扫描被用户终止")
                    break

                port = future_to_port[future]
                try:
                    result = future.result()
                    if result:
                        found += 1
                        self.log(result)
                except:
                    pass

                self.status_var.set(f"已完成 {len(future_to_port) - len(future_to_port)} / {total}  开放: {found}")

        if self.running:
            self.log(f"\n扫描完成！发现 {found} 个开放端口")
            self.running = False
            self.btn_start.config(text="开始扫描")
            self.status_var.set(f"完成 - 开放端口: {found}")


